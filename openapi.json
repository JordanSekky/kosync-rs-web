{
  "openapi": "3.1.0",
  "info": {
    "title": "kosync-proxy admin API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness check",
        "operationId": "health",
        "responses": {
          "default": {
            "description": "The body of every error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "List registered users",
        "operationId": "listUsers",
        "responses": {
          "default": {
            "description": "The body of every error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListUsersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get a registered user",
        "operationId": "getUser",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "style": "simple"
          }
        ],
        "responses": {
          "default": {
            "description": "The body of every error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/progress": {
      "get": {
        "tags": [
          "progress"
        ],
        "summary": "List progress history",
        "description": "Entries across all users, newest first, narrowed by the filters. Page through them by passing each response's `next_cursor` back as `cursor`.",
        "operationId": "listProgress",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "description": "The `next_cursor` of the previous page",
            "schema": {
              "description": "The `next_cursor` of the previous page",
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "device",
            "description": "Only entries pushed from a device with this name",
            "schema": {
              "description": "Only entries pushed from a device with this name",
              "type": [
                "string",
                "null"
              ]
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "device_id",
            "description": "Only entries pushed from a device with this id",
            "schema": {
              "description": "Only entries pushed from a device with this id",
              "type": [
                "string",
                "null"
              ]
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "document",
            "description": "Only entries of this document, as reported by `listBooks`",
            "schema": {
              "description": "Only entries of this document, as reported by `listBooks`",
              "type": [
                "string",
                "null"
              ]
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "from",
            "description": "Only entries at or after this time",
            "schema": {
              "description": "Only entries at or after this time",
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "limit",
            "description": "Page size, 100 if absent and at most 500",
            "schema": {
              "description": "Page size, 100 if absent and at most 500",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "to",
            "description": "Only entries before this time",
            "schema": {
              "description": "Only entries before this time",
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "user_id",
            "description": "Only entries of this user",
            "schema": {
              "description": "Only entries of this user",
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "style": "form"
          }
        ],
        "responses": {
          "default": {
            "description": "The body of every error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListProgressResponse"
                }
              }
            }
          }
        }
      }
    },
    "/books": {
      "get": {
        "tags": [
          "books"
        ],
        "summary": "List documents with progress history",
        "operationId": "listBooks",
        "parameters": [
          {
            "in": "query",
            "name": "user_id",
            "description": "Only documents this user has synced",
            "schema": {
              "description": "Only documents this user has synced",
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "style": "form"
          }
        ],
        "responses": {
          "default": {
            "description": "The body of every error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListBooksResponse"
                }
              }
            }
          }
        }
      }
    },
    "/devices": {
      "get": {
        "tags": [
          "devices"
        ],
        "summary": "List devices progress was pushed from",
        "operationId": "listDevices",
        "parameters": [
          {
            "in": "query",
            "name": "user_id",
            "description": "Only devices this user has pushed from",
            "schema": {
              "description": "Only devices this user has pushed from",
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "style": "form"
          }
        ],
        "responses": {
          "default": {
            "description": "The body of every error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListDevicesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/logs": {
      "get": {
        "tags": [
          "logs"
        ],
        "summary": "Stream application logs",
        "description": "Server-sent events: the cached log entries, oldest first, followed by new ones as they are logged. Use `EventSource` rather than `fetch`, which reconnects and resumes by itself.",
        "operationId": "streamLogs",
        "parameters": [
          {
            "in": "header",
            "name": "Last-Event-ID",
            "description": "The `id` of the last event received, which `EventSource` sends by itself when it reconnects. The stream then continues after that entry instead of replaying the cache. Ignored if it came from before the server last restarted.",
            "schema": {
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "responses": {
          "default": {
            "description": "The body of every error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "A `text/event-stream` that stays open until the client disconnects or the server shuts down. Each event's `data` is one `LogEntry` as JSON, and its `id` can be sent back as `Last-Event-ID`.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/LogEntry"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookResponse": {
        "type": "object",
        "properties": {
          "title": {
            "description": "Null unless a client sent metadata for the document",
            "type": [
              "string",
              "null"
            ]
          },
          "authors": {
            "type": [
              "string",
              "null"
            ]
          },
          "document": {
            "description": "The document's id, which the client derives from the file",
            "type": "string"
          },
          "entry_count": {
            "description": "Number of progress history entries for the document",
            "type": "integer",
            "format": "int64"
          },
          "filename": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_activity_at": {
            "type": "string",
            "format": "date-time"
          },
          "reader_count": {
            "description": "Number of users that have synced the document",
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "document",
          "reader_count",
          "entry_count",
          "last_activity_at"
        ]
      },
      "DeviceResponse": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string"
          },
          "device_id": {
            "description": "Null for clients that don't send one",
            "type": [
              "string",
              "null"
            ]
          },
          "entry_count": {
            "description": "Number of progress history entries pushed from the device",
            "type": "integer",
            "format": "int64"
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "device",
          "entry_count",
          "last_seen_at"
        ]
      },
      "ErrorResponse": {
        "description": "The body of every error response.",
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Always \"ok\"",
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "ListBooksQuery": {
        "type": "object",
        "properties": {
          "user_id": {
            "description": "Only documents this user has synced",
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "ListBooksResponse": {
        "type": "object",
        "properties": {
          "books": {
            "description": "Most recently synced first",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookResponse"
            }
          }
        },
        "required": [
          "books"
        ]
      },
      "ListDevicesQuery": {
        "type": "object",
        "properties": {
          "user_id": {
            "description": "Only devices this user has pushed from",
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "ListDevicesResponse": {
        "type": "object",
        "properties": {
          "devices": {
            "description": "Most recently seen first",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceResponse"
            }
          }
        },
        "required": [
          "devices"
        ]
      },
      "ListProgressQuery": {
        "type": "object",
        "properties": {
          "cursor": {
            "description": "The `next_cursor` of the previous page",
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "device": {
            "description": "Only entries pushed from a device with this name",
            "type": [
              "string",
              "null"
            ]
          },
          "device_id": {
            "description": "Only entries pushed from a device with this id",
            "type": [
              "string",
              "null"
            ]
          },
          "document": {
            "description": "Only entries of this document, as reported by `listBooks`",
            "type": [
              "string",
              "null"
            ]
          },
          "from": {
            "description": "Only entries at or after this time",
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "limit": {
            "description": "Page size, 100 if absent and at most 500",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0
          },
          "to": {
            "description": "Only entries before this time",
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "user_id": {
            "description": "Only entries of this user",
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "ListProgressResponse": {
        "type": "object",
        "properties": {
          "entries": {
            "description": "Newest first",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProgressEntryResponse"
            }
          },
          "next_cursor": {
            "description": "Pass as `cursor` to get the next page; null on the last page",
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        },
        "required": [
          "entries"
        ]
      },
      "ListUsersResponse": {
        "type": "object",
        "properties": {
          "users": {
            "description": "Oldest account first",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserResponse"
            }
          }
        },
        "required": [
          "users"
        ]
      },
      "LogEntry": {
        "description": "One event the application logged.",
        "type": "object",
        "properties": {
          "fields": {
            "description": "The event's other fields, with values rendered as text",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "id": {
            "description": "Consecutive within one run of the server, starting at 1. A gap means\n the client fell behind and some entries were skipped.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "level": {
            "$ref": "#/components/schemas/LogLevel"
          },
          "message": {
            "description": "Empty if the event had no message",
            "type": "string"
          },
          "spans": {
            "description": "The spans the event was logged inside of, outermost first. Handlers\n run in a span whose fields name the user and document, for example.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LogSpan"
            }
          },
          "target": {
            "description": "The module that logged it, such as `kosync_proxy::upstream`",
            "type": "string"
          },
          "timestamp": {
            "description": "When the event was logged",
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "timestamp",
          "level",
          "target",
          "message",
          "fields",
          "spans"
        ]
      },
      "LogLevel": {
        "type": "string",
        "enum": [
          "trace",
          "debug",
          "info",
          "warn",
          "error"
        ]
      },
      "LogSpan": {
        "description": "A span an event was logged inside of.",
        "type": "object",
        "properties": {
          "fields": {
            "description": "The span's fields, including ones recorded after it was created, with\n values rendered as text",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "name": {
            "description": "For handlers, the name of the function",
            "type": "string"
          }
        },
        "required": [
          "name",
          "fields"
        ]
      },
      "ProgressEntryResponse": {
        "type": "object",
        "properties": {
          "title": {
            "description": "Null unless the client sent metadata for the document",
            "type": [
              "string",
              "null"
            ]
          },
          "authors": {
            "type": [
              "string",
              "null"
            ]
          },
          "device": {
            "type": "string"
          },
          "device_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "document": {
            "description": "The document's id, which the client derives from the file",
            "type": "string"
          },
          "filename": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "percentage": {
            "description": "In [0, 1]",
            "type": "number",
            "format": "double"
          },
          "progress": {
            "description": "Opaque position: an XPointer for reflowable documents, a page number\n for paged ones",
            "type": "string"
          },
          "timestamp": {
            "description": "When the server received the push",
            "type": "string",
            "format": "date-time"
          },
          "user_id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "user_id",
          "username",
          "document",
          "progress",
          "percentage",
          "device",
          "timestamp"
        ]
      },
      "UserPath": {
        "description": "A struct rather than a bare `i64` so the spec can name the parameter.",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "id"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "book_count": {
            "description": "Number of distinct documents the user has synced",
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "entry_count": {
            "description": "Number of progress history entries the user has pushed",
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "last_active_at": {
            "description": "When the user last pushed progress; null if they never have",
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "created_at",
          "entry_count",
          "book_count"
        ]
      }
    }
  }
}
